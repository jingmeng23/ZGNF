# Copy to .env.android.local. All VITE_* values are public, never put secrets here.
VITE_API_BASE_URL=https://shop.example.com/api/v1
VITE_DEMO_MODE=false
VITE_LOGIN_DISABLED=false
VITE_AMAP_KEY=
VITE_AMAP_SECURITY_CODE=
# Debug only: use http://10.0.2.2:8081/api/v1 for the Android emulator.
# Physical devices must use your computer's LAN address, not localhost.
ANDROID_ALLOW_HTTP=false
