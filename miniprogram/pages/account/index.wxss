.account-page { padding: 0 32rpx 40rpx; padding-bottom: calc(40rpx + env(safe-area-inset-bottom)); }
.account-header { padding: 30rpx 0 32rpx; }
.brand-label { color: #61776c; font-size: 24rpx; margin-bottom: 20rpx; }
.account-page button { margin: 0; padding: 0; min-height: 44px; border: 0; border-radius: 0; color: #26382e; background: transparent; font-size: 28rpx; font-weight: 400; line-height: 1.5; text-align: left; }
.account-page button::after { border: 0; }
.account-page .profile-button { display: flex; align-items: center; width: 100%; padding: 4rpx 0; }
.avatar { width: 112rpx; height: 112rpx; border-radius: 50%; background: #e6f0e7; display: flex; align-items: center; justify-content: center; flex-shrink: 0; overflow: hidden; }
.avatar-image { width: 100%; height: 100%; }
.avatar-placeholder { width: 64rpx; height: 64rpx; }
.profile-copy { min-width: 0; flex: 1; margin: 0 24rpx; }
.profile-name { font-size: 38rpx; font-weight: 600; color: #163f35; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.profile-description { margin-top: 8rpx; font-size: 24rpx; color: #617269; }
.chevron { width: 12rpx; height: 12rpx; border-top: 3rpx solid #84948b; border-right: 3rpx solid #84948b; transform: rotate(45deg); flex-shrink: 0; margin-right: 6rpx; }
.account-card { border-radius: 24rpx; background: #fff; margin-bottom: 24rpx; padding: 0 24rpx; overflow: hidden; }
.card-heading { display: flex; align-items: center; justify-content: space-between; min-height: 92rpx; gap: 12rpx; }
.card-title { font-size: 36rpx; font-weight: 600; }
.account-page .all-orders { display: flex; align-items: center; justify-content: flex-end; gap: 14rpx; font-size: 24rpx; color: #63756a; flex-shrink: 0; }
.shortcut-grid { display: flex; padding: 0 0 20rpx; }
.account-page .shortcut { display: flex; flex: 1; min-width: 0; min-height: 124rpx; flex-direction: column; align-items: center; justify-content: center; gap: 12rpx; font-size: 24rpx; text-align: center; border-radius: 12rpx; }
.shortcut-icon { width: 52rpx; height: 52rpx; flex-shrink: 0; }
.account-page .points-summary { display: flex; align-items: center; gap: 12rpx; padding: 0 20rpx; margin-bottom: 16rpx; border-radius: 12rpx; color: #52695b; background: #f0f5ef; font-size: 24rpx; }
.points-value { color: #163f35; font-weight: 600; font-size: 30rpx; }
.points-link { margin-left: auto; }
.service-list { border-top: 1rpx solid #edf0eb; }
.account-page .menu-row { display: flex; width: 100%; min-height: 104rpx; align-items: center; gap: 22rpx; border-bottom: 1rpx solid #edf0eb; }
.account-page .menu-row:last-child { border-bottom: 0; }
.row-icon { width: 40rpx; height: 40rpx; flex-shrink: 0; }
.menu-label { flex: 1; }
.row-hint { font-size: 24rpx; color: #738177; }
.chevron-down { transform: rotate(135deg); margin-bottom: 8rpx; }
.chevron-up { transform: rotate(-45deg); margin-top: 8rpx; }
.settings-list { border-top: 1rpx solid #edf0eb; }
.account-page .settings-row { padding-left: 62rpx; }
.account-page .logout-button { width: 100%; text-align: center; color: #a4412b; min-height: 104rpx; }
.account-page .staff-entry { display: flex; align-items: center; justify-content: center; gap: 16rpx; width: 100%; color: #6b7c71; font-size: 24rpx; }
.profile-error { display: flex; align-items: center; gap: 16rpx; padding: 8rpx 20rpx; margin-bottom: 24rpx; background: #fff1e9; border-radius: 16rpx; color: #8f442c; }
.error-copy { flex: 1; font-size: 24rpx; }
.account-page .retry-button { min-width: 44px; flex-shrink: 0; text-align: center; color: #8f442c; }
.account-page .account-pressed { background: #edf3ed; }
