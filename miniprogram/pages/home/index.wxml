<view class="page"><view class="hero"><view class="eyebrow">WARM HOME · BETTER LIFE</view><view class="title"><view>安心用气，</view><view>温暖到家。</view></view><view class="muted">品质好物与专业上门服务</view><button class="secondary" bindtap="catalog">探索商城</button></view><button class="secondary" bindtap="services">安装 · 维修 · 安全检查预约</button><view class="section">为家精选</view><view wx:if="error" class="error" bindtap="load">{{error}} · 点击重试</view><view wx:if="loading" class="empty">正在加载…</view><view class="grid"><view wx:for="products" wx:key="id" class="card" data-id="{{item.id}}" bindtap="product"><image wx:if="item.image" src="{{item.image}}" class="image" mode="aspectFit"/><view>{{item.name}}</view><view class="muted">{{item.subtitle}}</view><view class="price">¥{{item.price}}</view></view></view></view>
