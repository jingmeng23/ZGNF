<view class="page"><view class="title">我的订单</view><view class="actions"><button class="secondary small" bindtap="filter">全部</button><button class="secondary small" data-status="pending_payment" bindtap="filter">待付款</button><button class="secondary small" data-status="processing" bindtap="filter">待完成</button><button class="secondary small" data-status="completed" bindtap="filter">已完成</button></view><view wx:if="error" class="error" bindtap="load">{{error}} · 重试</view><view wx:for="rows" wx:key="id" class="card" data-id="{{item.id}}" bindtap="open"><view class="row"><view>{{item.orderNo}}</view><view class="status">{{item.label}}</view></view><view wx:for="item.items" wx:for-item="product" wx:key="productId">{{product.productName}} × {{product.quantity}}</view><view class="row"><view class="price">¥{{item.payAmount}}</view><view>查看 / 付款 ›</view></view></view><view wx:if="!rows.length && !loading" class="empty">暂无匹配订单</view><view class="actions"><button class="secondary" bindtap="previous" disabled="{{loading || page <= 1}}">上一页</button><button class="secondary" bindtap="next" disabled="{{loading || page >= pages}}">下一页</button></view></view>
