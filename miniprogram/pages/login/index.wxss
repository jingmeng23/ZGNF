page { background: #f5f7f4; }
.login-page { box-sizing: border-box; max-width: 960rpx; margin: 0 auto; padding: 32rpx 32rpx 32rpx; padding-bottom: calc(32rpx + env(safe-area-inset-bottom)); }
.login-brand { display: flex; flex-direction: column; gap: 8rpx; padding: 0 8rpx 24rpx; }
.brand-name { color: #163f35; font-size: 40rpx; font-weight: 700; letter-spacing: 4rpx; }
.brand-caption { color: #65796e; font-size: 25rpx; }
.login-card { background: #fff; padding: 32rpx 28rpx 20rpx; border: 1rpx solid #e7ece7; border-radius: 24rpx; box-shadow: 0 12rpx 40rpx rgba(22, 63, 53, .035); }
.login-heading { font-size: 40rpx; font-weight: 600; color: #163f35; line-height: 1.4; }
.login-description { margin: 8rpx 0 24rpx; color: #65776c; font-size: 26rpx; line-height: 1.65; }
.form-field { margin-top: 20rpx; }
.field-label { font-size: 28rpx; color: #2e4238; margin-bottom: 10rpx; line-height: 1.4; }
.optional-label { color: #748078; font-size: 24rpx; margin-left: 4rpx; }
.input-shell { display: flex; align-items: center; min-height: 48px; background: #f6f8f5; border: 2rpx solid #e2e9e2; border-radius: 16rpx; overflow: hidden; }
.input-shell.input-focused { border-color: #163f35; background: #fff; }
.input-shell.input-error { border-color: #b54728; }
.login-page .login-input { flex: 1; min-width: 0; width: 0; height: 48px; padding: 0 24rpx; margin: 0; border-radius: 0; background: transparent; font-size: 28rpx; color: #26382e; line-height: normal; }
.input-placeholder { color: #859087; font-size: 28rpx; }
.field-hint { margin-top: 10rpx; color: #66776c; font-size: 24rpx; line-height: 1.5; }
.login-page button { display: flex; align-items: center; justify-content: center; box-sizing: border-box; min-height: 44px; padding: 16rpx 24rpx; margin: 0; border-radius: 14rpx; line-height: 1.5; font-size: 28rpx; font-weight: 500; }
.login-page button::after { border: 0; }
.login-page .field-action { align-self: stretch; min-width: 52px; padding: 0 16rpx; background: transparent; color: #163f35; font-size: 24rpx; border-radius: 0; flex-shrink: 0; }
.login-page .primary-button { width: 100%; min-height: 48px; margin-top: 28rpx; background: #087f95; color: #fff; font-size: 30rpx; font-weight: 600; }
.login-page .text-button { color: #516c5d; background: transparent; font-size: 26rpx; }
.login-page .mode-switch { width: 100%; margin-top: 8rpx; }
.login-divider { display: flex; align-items: center; gap: 24rpx; color: #7b897e; font-size: 24rpx; margin: 12rpx 0 16rpx; }
.divider-line { height: 1rpx; background: #e9eee7; flex: 1; }
.login-page .wechat-button { width: 100%; min-height: 48px; background: #e6f0e7; color: #163f35; border: 1rpx solid #dbe7dc; }
.wechat-hint { text-align: center; margin-top: 14rpx; color: #6b7c70; font-size: 24rpx; }
.feedback { padding: 20rpx 24rpx; font-size: 26rpx; border-radius: 14rpx; overflow-wrap: break-word; line-height: 1.6; margin-bottom: 24rpx; }
.feedback-error { color: #9e3f26; background: #fff2ec; border: 1rpx solid #f0d9ce; }
.feedback-success { color: #285340; background: #e6f0e7; border: 1rpx solid #dbe7dc; }
.login-footer { padding: 16rpx 0 0; display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 0 8rpx; }
.login-page .browse-button { background: transparent; color: #163f35; gap: 16rpx; }
.browse-arrow { width: 10rpx; height: 10rpx; border-top: 2rpx solid #61796c; border-right: 2rpx solid #61796c; transform: rotate(45deg); }
.login-page .help-button { color: #697b6e; font-size: 24rpx; }
.footer-note { width: 100%; text-align: center; margin-top: 4rpx; color: #7b897e; font-size: 24rpx; }
.binding-content { padding-top: 4rpx; }
.binding-symbol { width: 120rpx; height: 120rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: #f0f5ef; margin: 12rpx auto 24rpx; }
.binding-complete { background: #e6f0e7; }
.binding-icon { width: 64rpx; height: 64rpx; }
.binding-note { text-align: center; color: #61776a; font-size: 28rpx; line-height: 1.8; }
.binding-content .text-button { width: 100%; margin-top: 12rpx; }
.login-page .login-pressed { background: #edf3ed; }
.login-page .primary-pressed { background: #066e81; }
.login-page button[disabled] { opacity: .55; }
@media (max-width: 340px) {
  .login-page { padding-left: 24rpx; padding-right: 24rpx; padding-top: 28rpx; }
  .login-card { padding-left: 28rpx; padding-right: 28rpx; }
  .login-page .login-input, .input-placeholder { font-size: 14px; }
  .field-label, .login-page button { font-size: 14px; }
}
