<view class="page"><view class="title">退款与售后</view><view wx:if="error" class="error">{{error}}</view><view wx:if="orderId" class="card"><view>申请整单退款</view><textarea value="{{reason}}" data-field="reason" bindinput="input" maxlength="500" placeholder="请说明退款原因"/><button bindtap="submit" disabled="{{busy}}" loading="{{busy}}">提交售后申请</button></view><view wx:else class="notice">需要退款时，请从“我的订单 → 订单详情”发起申请。</view><view wx:for="rows" wx:key="id" class="card"><view>{{item.aftersaleNo}}</view><view class="status">{{item.status}}</view><view>退款金额 ¥{{item.amount}}</view><view>{{item.reason}}</view><view class="muted">{{item.reviewRemark}}</view><button wx:if="item.status === 'pending'" class="secondary" data-id="{{item.id}}" bindtap="cancel">撤销申请</button></view><view class="actions"><button class="secondary" bindtap="previous" disabled="{{page <= 1}}">上一页</button><button class="secondary" bindtap="next" disabled="{{page >= pages}}">下一页</button></view></view>
