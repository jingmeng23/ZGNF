<view class="page">
  <view class="title">我的订单</view>
  <scroll-view scroll-x><view style="display:flex;gap:16rpx;white-space:nowrap"><button wx:for="{{statuses}}" wx:key="id" class="{{status === item.id ? 'small' : 'secondary small'}}" data-status="{{item.id}}" bindtap="filter" disabled="{{loading}}">{{item.name}}</button></view></scroll-view>
  <view class="row"><input placeholder="完整订单号" value="{{orderNo}}" bindinput="input" bindconfirm="search" maxlength="40" disabled="{{loading}}"/><button class="small" bindtap="search" disabled="{{loading}}">查询</button></view>
  <view wx:if="{{error}}" class="error">{{error}}</view><view class="muted">共 {{total}} 笔订单</view>
  <view wx:for="{{rows}}" wx:key="id" class="card" data-id="{{item.id}}" bindtap="open"><view class="row"><text>{{item.orderNo}}</text><text class="status">{{item.label}}</text></view><view class="muted">{{item.createTime}}</view><view class="divider"/><view wx:for="{{item.items}}" wx:for-item="product" wx:key="productId">{{product.productName}} × {{product.quantity}}</view><view class="row"><text class="price">¥{{item.payAmount}}</text><text>{{item.status === 'pending_payment' ? '去付款' : '查看详情'}} ›</text></view></view>
  <view wx:if="{{loading}}" class="empty">正在加载订单…</view><view wx:elif="{{!rows.length}}" class="empty">暂无匹配订单</view>
  <view class="actions"><button class="secondary" bindtap="previous" disabled="{{loading || page <= 1}}">上一页</button><text>{{page}} / {{pages}}</text><button class="secondary" bindtap="next" disabled="{{loading || page >= pages}}">下一页</button></view>
  <button wx:if="{{error}}" class="secondary" bindtap="load" disabled="{{loading}}">重新加载</button>
</view>
