<view class="page">
  <view class="title">订单详情</view><view wx:if="{{error}}" class="error">{{error}}</view><view wx:if="{{notice}}" class="notice">{{notice}}</view>
  <block wx:if="{{order}}">
    <view class="card"><view class="status">{{label}}</view><view class="row"><text selectable>{{order.orderNo}}</text><button class="secondary small" data-value="{{order.orderNo}}" bindtap="copy">复制</button></view><view class="muted">下单时间 {{order.createTime}}</view><view wx:if="{{order.status === 'pending_payment'}}" class="muted">付款截止 {{order.expireTime}}</view><view class="divider"/>
      <view wx:for="{{order.items}}" wx:key="productId" class="row" style="padding:12rpx 0" data-id="{{item.productId}}" bindtap="product"><view>{{item.productName}} × {{item.quantity}}</view><view>¥{{item.unitPrice}} ›</view></view><view class="divider"/>
      <view class="row"><text>商品总额</text><text>¥{{order.totalAmount}}</text></view><view class="row"><text>运费</text><text>¥{{order.freightAmount}}</text></view><view class="row"><text>优惠合计</text><text>−¥{{order.discountAmount}}</text></view><view class="row"><text>应付金额</text><text class="price">¥{{order.payAmount}}</text></view><view wx:if="{{order.remark}}" class="muted">订单备注：{{order.remark}}</view>
    </view>
    <view wx:if="{{order.address}}" class="card"><view class="section">收货信息</view><view>{{order.address.receiver}} · {{order.address.phone}}</view><view>{{order.address.province}}{{order.address.city}}{{order.address.district}}{{order.address.detail}}</view></view>
    <view wx:if="{{order.logistics}}" class="card"><view class="section">物流信息</view><view>{{order.logistics.carrier}}</view><view class="row"><text selectable>{{order.logistics.trackingNo}}</text><button class="secondary small" data-value="{{order.logistics.trackingNo}}" bindtap="copy">复制单号</button></view><view class="muted">{{order.logistics.summary}}</view></view>
    <block wx:if="{{order.status === 'pending_payment'}}"><button bindtap="pay" loading="{{busy}}" disabled="{{busy || loading}}">微信支付 ¥{{order.payAmount}}</button><button class="secondary" bindtap="bind" disabled="{{busy || loading}}">绑定当前微信</button><button class="secondary" data-action="cancel" bindtap="action" disabled="{{busy || loading}}">取消订单</button></block>
    <button wx:if="{{order.status === 'processing'}}" data-action="confirm-receipt" bindtap="action" disabled="{{busy || loading}}">确认收货 / 服务完成</button>
    <button wx:if="{{order.status === 'paid' || order.status === 'processing' || order.status === 'completed'}}" class="secondary" bindtap="refund" disabled="{{busy || loading}}">申请整单退款</button>
    <button class="secondary" bindtap="aftersales" disabled="{{busy || loading}}">查看本单售后</button>
    <view wx:if="{{timeline.length}}" class="card"><view class="section">订单进度</view><view wx:for="{{timeline}}" wx:key="id" style="padding:12rpx 0"><view>{{item.label}}</view><view class="muted">{{item.occurredAt}}</view></view></view>
    <view wx:if="{{payments.length}}" class="section">支付记录</view><view wx:for="{{payments}}" wx:key="paymentNo" class="card"><view selectable>{{item.paymentNo}}</view><view>{{item.channelLabel}} · {{item.label}} · ¥{{item.amount}}</view><view class="muted">{{item.paidTime}}</view></view>
  </block>
  <button class="secondary" bindtap="load" loading="{{loading}}" disabled="{{busy || loading}}">刷新订单状态</button>
</view>
