<view class="page"><view class="title">订单详情</view><view wx:if="error" class="error">{{error}}</view><view wx:if="notice" class="notice">{{notice}}</view><block wx:if="order"><view class="card"><view class="status">{{label}}</view><view>{{order.orderNo}}</view><view class="muted">{{order.createTime}}</view><view class="divider"/><view wx:for="order.items" wx:key="productId" class="row"><view>{{item.productName}} × {{item.quantity}}</view><view>¥{{item.unitPrice}}</view></view><view class="divider"/><view class="price">应付 ¥{{order.payAmount}}</view></view><view wx:if="order.address" class="card"><view>{{order.address.receiver}} · {{order.address.phone}}</view><view>{{order.address.province}}{{order.address.city}}{{order.address.district}}{{order.address.detail}}</view></view><view wx:if="order.logistics" class="card"><view>{{order.logistics.carrier}} {{order.logistics.trackingNo}}</view><view>{{order.logistics.summary}}</view></view><view wx:if="order.status === 'pending_payment'"><button bindtap="pay" loading="{{busy}}" disabled="{{busy}}">微信支付 ¥{{order.payAmount}}</button><button class="secondary" bindtap="bind" disabled="{{busy}}">首次付款先绑定微信</button><button class="secondary" data-action="cancel" bindtap="action" disabled="{{busy}}">取消订单</button></view><button wx:if="order.status === 'processing'" data-action="confirm-receipt" bindtap="action" disabled="{{busy}}">确认完成</button><button wx:if="order.status === 'paid' || order.status === 'processing' || order.status === 'completed'" class="secondary" bindtap="refund">申请整单退款</button><view wx:for="order.payments" wx:key="paymentNo" class="card"><view>支付单 {{item.paymentNo}}</view><view>{{item.status}} · ¥{{item.amount}}</view></view></block><button class="secondary" bindtap="load" disabled="{{busy}}">刷新订单状态</button></view>
