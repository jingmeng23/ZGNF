<view class="page manage-page">
  <view class="eyebrow">自贡能发 · 员工工作台</view>
  <view class="title">{{current ? current.title : '经营管理'}}</view>
  <view wx:if="{{error}}" class="error">{{error}}</view>
  <view wx:if="{{notice}}" class="notice">{{notice}}</view>
  <view wx:if="{{!profile}}" class="card">
    <view class="section">管理员登录</view>
    <view class="muted">使用已分配管理权限的员工账号</view>
    <input placeholder="员工账号" value="{{username}}" data-field="username" bindinput="input" maxlength="64" disabled="{{busy}}"/>
    <input placeholder="密码" password value="{{password}}" data-field="password" bindinput="input" bindconfirm="login" maxlength="72" disabled="{{busy}}"/>
    <button loading="{{busy}}" disabled="{{busy}}" bindtap="login">登录管理工作台</button>
  </view>
  <block wx:elif="{{!current}}">
    <view class="card row"><view>{{profile.name || profile.username}}<view class="muted">{{profile.username}}</view></view><view class="status">员工账号</view></view>
    <view class="grid">
      <view wx:for="{{modules}}" wx:key="key" class="card module-card" data-key="{{item.key}}" bindtap="open">
        <view class="section">{{item.title}}</view><view class="muted">{{item.description}}</view><view class="module-enter">进入模块 ›</view>
      </view>
    </view>
    <view wx:if="{{!modules.length}}" class="empty">暂无可访问的模块，请联系管理员分配权限</view>
    <button class="secondary" disabled="{{busy}}" bindtap="restore">刷新权限</button>
    <button class="secondary" disabled="{{busy}}" bindtap="logout">退出管理账号</button>
  </block>
  <block wx:else>
    <view class="row toolbar"><text class="muted">{{canWrite ? '可查看和管理' : '仅查看'}}</text><button class="secondary small" disabled="{{busy}}" bindtap="home">返回工作台</button></view>
    <block wx:if="{{fields !== null}}">
      <view class="card">
        <view class="section">{{operation.label}}</view>
        <view wx:if="{{!formReady}}" class="muted">正在准备关联资料…</view>
        <button wx:if="{{!formReady && !busy}}" class="secondary" bindtap="prepareChoices">重试加载选项</button>
        <block wx:if="{{formReady}}">
          <view wx:for="{{fields}}" wx:for-item="field" wx:key="key" class="form-field">
            <view class="label">{{field.label}}<text wx:if="{{field.required}}" class="required"> *</text></view>
            <block wx:if="{{field.type === 'image' || field.type === 'images'}}">
              <view class="muted">支持 JPG、PNG、GIF，单张不超过 10MB</view>
              <view class="upload-images">
                <view wx:for="{{field.images}}" wx:for-item="picture" wx:for-index="imageIndex" wx:key="index" class="upload-image">
                  <image src="{{picture.src}}" mode="aspectFit" data-url="{{picture.src}}" bindtap="previewImage"/>
                  <view class="muted">{{field.type === 'image' ? '封面' : '详情图 ' + (imageIndex + 1)}}</view>
                  <view class="actions">
                    <button wx:if="{{field.type === 'images'}}" class="secondary small" data-key="{{field.key}}" data-index="{{imageIndex}}" data-offset="-1" bindtap="changeImage" disabled="{{busy || formLocked || imageIndex === 0}}">前移</button>
                    <button wx:if="{{field.type === 'images'}}" class="secondary small" data-key="{{field.key}}" data-index="{{imageIndex}}" data-offset="1" bindtap="changeImage" disabled="{{busy || formLocked || imageIndex === field.images.length - 1}}">后移</button>
                    <button class="secondary small" data-key="{{field.key}}" data-index="{{imageIndex}}" bindtap="changeImage" disabled="{{busy || formLocked}}">移除</button>
                  </view>
                </view>
              </view>
              <button class="secondary" data-key="{{field.key}}" bindtap="chooseImages" disabled="{{busy || formLocked || (field.type === 'images' && field.images.length >= 20)}}">{{field.type === 'image' ? (field.images.length ? '替换封面图片' : '上传封面图片') : '添加详情图片（' + field.images.length + '/20）'}}</button>
            </block>
            <block wx:elif="{{field.multiple}}">
              <view wx:if="{{!field.groups.length}}" class="muted">暂无可选择的项目</view>
              <view wx:for="{{field.groups}}" wx:for-item="group" wx:key="key" class="permission-group">
                <view class="row"><text>{{group.name}}</text><button class="secondary small" data-key="{{field.key}}" data-group="{{group.key}}" bindtap="groupSelect" disabled="{{busy || formLocked}}">{{group.allChecked ? '取消本组' : '选择本组'}}</button></view>
                <checkbox-group data-key="{{field.key}}" data-group="{{group.key}}" bindchange="checks">
                  <label wx:for="{{group.choices}}" wx:for-item="choice" wx:key="id" class="check-row"><checkbox value="{{choice.id}}" checked="{{choice.checked}}" disabled="{{busy || formLocked}}"/><view>{{choice.name}}<view wx:if="{{choice.permissionKey}}" class="muted">{{choice.permissionKey}}</view></view></label>
                </checkbox-group>
              </view>
            </block>
            <picker wx:elif="{{field.choices}}" range="{{field.choices}}" range-key="name" value="{{field.selectedIndex}}" data-key="{{field.key}}" bindchange="pick" disabled="{{busy || formLocked || field.disabled}}">{{field.selectedLabel}} <text class="muted">⌄</text></picker>
            <textarea wx:elif="{{field.type === 'textarea' || field.type === 'lines'}}" value="{{form[field.key]}}" data-key="{{field.key}}" bindinput="formInput" maxlength="{{field.maxLength}}" disabled="{{busy || formLocked || field.disabled}}" placeholder="{{field.required ? '请填写' : '可留空'}}"/>
            <input wx:else value="{{form[field.key]}}" password="{{field.type === 'password'}}" type="{{field.type === 'money' ? 'digit' : field.type === 'number' || field.type === 'positive' ? 'number' : 'text'}}" data-key="{{field.key}}" bindinput="formInput" maxlength="{{field.maxLength}}" disabled="{{busy || formLocked || field.disabled}}" placeholder="{{field.required ? '请填写' : '可留空'}}"/>
          </view>
        </block>
        <view wx:if="{{current.key === 'inventory' && detail}}" class="notice">实物 {{detail.quantity}} · 锁定 {{detail.lockedQuantity}} · 可用 {{detail.availableQuantity}}</view>
        <button bindtap="submit" loading="{{busy}}" disabled="{{busy || !formReady}}">{{formLocked ? '使用原请求重试' : '确认保存'}}</button>
        <button class="secondary" disabled="{{busy}}" bindtap="closeForm">返回{{detail ? '详情' : '列表'}}</button>
      </view>
    </block>
    <block wx:elif="{{records}}">
      <view class="card">
        <view class="section">{{records.title}}</view>
        <block wx:if="{{records.key === 'logs'}}">
          <picker range="{{records.typeChoices}}" range-key="name" data-key="changeType" bindchange="recordFilter" disabled="{{busy}}">{{records.typeLabel}} ⌄</picker>
          <input placeholder="关联订单号 / 业务单号" value="{{records.referenceNo}}" data-key="referenceNo" bindinput="recordFilter" bindconfirm="searchRecords" maxlength="64" disabled="{{busy}}"/>
          <button class="secondary" bindtap="searchRecords" disabled="{{busy}}">查询流水</button>
        </block>
        <view class="muted">共 {{records.total}} 条记录</view>
      </view>
      <view wx:for="{{records.rows}}" wx:key="id" class="card"><view class="section">{{item.title}}</view><view wx:for="{{item.lines}}" wx:for-item="line" wx:key="label" class="detail-line"><text class="muted">{{line.label}}</text><text selectable>{{line.value}}</text></view></view>
      <view wx:if="{{!records.rows.length && !busy}}" class="empty">暂无操作记录</view>
      <view class="actions pagination"><button class="secondary" data-delta="-1" bindtap="recordPage" disabled="{{busy || records.page <= 1}}">上一页</button><text>{{records.page}} / {{records.pages}}</text><button class="secondary" data-delta="1" bindtap="recordPage" disabled="{{busy || records.page >= records.pages}}">下一页</button></view>
      <button class="secondary" bindtap="closeRecords" disabled="{{busy}}">返回详情</button>
    </block>
    <block wx:elif="{{detail}}">
      <view class="card">
        <image wx:if="{{cover}}" class="image" src="{{cover}}" mode="aspectFit" data-url="{{cover}}" bindtap="previewImage"/>
        <view wx:for="{{detailLines}}" wx:key="label" class="detail-line"><text class="muted">{{item.label}}</text><text selectable>{{item.value}}</text></view>
      </view>
      <view wx:for="{{sections}}" wx:for-item="section" wx:key="title" class="card">
        <view class="section">{{section.title}}</view><view wx:if="{{!section.entries.length}}" class="muted">暂无记录</view>
        <view wx:for="{{section.entries}}" wx:for-item="entry" wx:key="index" class="detail-entry"><view wx:if="{{entry.title}}" class="entry-title">{{entry.title}}</view><view wx:for="{{entry.lines}}" wx:for-item="line" wx:key="label" class="detail-line"><text class="muted">{{line.label}}</text><text selectable>{{line.value}}</text></view></view>
      </view>
      <view wx:if="{{detailImages.length}}" class="card"><view class="section">商品详情图</view><image wx:for="{{detailImages}}" wx:key="*this" src="{{item}}" mode="widthFix" class="detail-image" data-url="{{item}}" bindtap="previewImage"/></view>
      <view class="actions"><button wx:if="{{canWrite && current.fields && !current.createOnly}}" bindtap="edit" disabled="{{busy}}">编辑资料</button><button wx:for="{{actions}}" wx:key="key" data-key="{{item.key}}" bindtap="action" disabled="{{busy}}" class="{{item.method === 'GET' ? 'secondary' : ''}}">{{item.label}}</button></view>
      <view class="actions"><button wx:for="{{relatedLinks}}" wx:key="key" class="secondary" data-key="{{item.key}}" bindtap="related" disabled="{{busy}}">{{item.title}}</button></view>
      <view wx:if="{{removalHint}}" class="muted">{{removalHint}}</view>
      <button wx:if="{{canRemove}}" class="danger secondary" bindtap="remove" disabled="{{busy}}">删除记录</button>
      <button class="secondary" bindtap="back" disabled="{{busy}}">返回列表</button>
    </block>
    <block wx:else>
      <view class="card">
        <input wx:if="{{current.search}}" placeholder="{{current.searchLabel}}" value="{{keyword}}" data-field="keyword" bindinput="input" bindconfirm="search" maxlength="{{current.search === 'keyword' ? 100 : 40}}" disabled="{{busy}}"/>
        <view class="actions"><button bindtap="search" loading="{{busy}}" disabled="{{busy}}">查询</button><button class="secondary" bindtap="toggleFilters">筛选{{showFilters ? ' ⌃' : ' ⌄'}}</button></view>
        <block wx:if="{{showFilters}}">
          <view wx:for="{{filters}}" wx:key="key"><view class="label">{{item.label}}</view>
            <picker wx:if="{{item.type === 'date'}}" mode="date" value="{{filterValues[item.key]}}" data-key="{{item.key}}" bindchange="filterInput" disabled="{{busy}}">{{filterValues[item.key] || '不限日期'}} ⌄</picker>
            <picker wx:elif="{{item.choices}}" range="{{item.choices}}" range-key="name" value="{{item.selectedIndex}}" data-key="{{item.key}}" bindchange="filterInput" disabled="{{busy}}">{{item.selectedLabel}} ⌄</picker>
            <input wx:else type="{{item.type === 'number' ? 'number' : 'text'}}" value="{{filterValues[item.key]}}" data-key="{{item.key}}" bindinput="filterInput" maxlength="{{item.maxLength}}" disabled="{{busy}}" placeholder="留空不限"/>
          </view>
          <button class="secondary" bindtap="resetFilters" disabled="{{busy}}">重置筛选</button>
        </block>
      </view>
      <view class="row"><text class="muted">共 {{total}} 条记录</text><button wx:if="{{canWrite && current.fields}}" class="small" data-create="yes" bindtap="edit" disabled="{{busy}}">{{current.key === 'inventory' ? '库存建账' : '新增'}}</button></view>
      <view wx:if="{{busy}}" class="empty">正在加载…</view>
      <view wx:elif="{{!rows.length}}" class="empty">暂无符合条件的记录</view>
      <view wx:for="{{rows}}" wx:key="id" class="card" data-id="{{item.id}}" bindtap="detail">
        <view class="row"><view class="entry-title">{{item.title}}</view><text wx:if="{{item.status}}" class="status">{{item.statusLabel}}</text><text wx:if="{{item.warning}}" class="warning">{{item.warning}}</text></view>
        <view class="muted">{{item.subtitle}}</view><view class="muted">编号 {{item.id}} · 查看详情 ›</view>
      </view>
      <view class="actions pagination"><button class="secondary" disabled="{{busy || page <= 1}}" bindtap="previous">上一页</button><text>{{page}} / {{pages}}</text><button class="secondary" disabled="{{busy || page >= pages}}" bindtap="next">下一页</button></view>
      <button class="secondary" disabled="{{busy}}" bindtap="load">刷新列表</button>
    </block>
  </block>
</view>
