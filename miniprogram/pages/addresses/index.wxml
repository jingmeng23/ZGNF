<view class="page"><view class="title">收货地址</view><view wx:if="error" class="error">{{error}}</view><view wx:for="rows" wx:key="id" class="card"><view data-id="{{item.id}}" bindtap="select"><view>{{item.receiver}} · {{item.phone}} {{item.isDefault ? '默认' : ''}}</view><view class="muted">{{item.province}}{{item.city}}{{item.district}}{{item.detail}}</view><view class="muted">点按选择此地址</view></view><view class="actions"><button class="secondary small" data-id="{{item.id}}" bindtap="edit">编辑</button><button class="secondary small" data-id="{{item.id}}" bindtap="remove">删除</button></view></view><button class="secondary" bindtap="add">新增地址</button><view wx:if="editing" class="card"><input value="{{form.receiver}}" data-field="receiver" bindinput="input" placeholder="收件人（2至20字）"/><input value="{{form.phone}}" data-field="phone" bindinput="input" maxlength="11" type="number" placeholder="手机号码"/><picker mode="region" value="{{region}}" bindchange="region">{{form.province ? form.province + ' / ' + form.city + ' / ' + form.district : '选择省 / 市 / 区'}}</picker><textarea value="{{form.detail}}" data-field="detail" bindinput="input" maxlength="255" placeholder="街道门牌详细地址，不少于5字"/><button bindtap="save" loading="{{busy}}" disabled="{{busy}}">保存地址</button></view></view>
