.module-card{margin-bottom:0;min-height:210rpx}.module-card .section{margin:0 0 12rpx}.module-enter{margin-top:24rpx;color:#285340;font-size:25rpx}.toolbar{margin-bottom:20rpx}.detail-line{display:flex;justify-content:space-between;align-items:flex-start;gap:24rpx;padding:12rpx 0;border-bottom:1rpx solid #edf1eb}.detail-line .muted{flex-shrink:0;max-width:45%}.detail-line text:last-child{text-align:right;word-break:break-all;white-space:pre-wrap}.detail-entry{padding:16rpx 0;border-bottom:1rpx solid #e5eae3}.entry-title{font-size:30rpx;font-weight:600;word-break:break-all}.detail-image{width:100%;margin:12rpx 0}.check-row{display:flex;align-items:center;gap:14rpx;padding:16rpx 0}.permission-group{padding:18rpx;border:1rpx solid #e5eae3;border-radius:12rpx;margin:16rpx 0}.pagination{align-items:center}.pagination text{flex-shrink:0}.warning{color:#a44121;background:#fff1e9;border-radius:12rpx;padding:4rpx 12rpx;font-size:24rpx}.required{color:#b84b34}.danger.secondary{color:#a44121}.form-field{margin:22rpx 0}.manage-page .section{margin-top:8rpx}
.upload-images{display:flex;flex-wrap:wrap;gap:20rpx;margin:16rpx 0}.upload-image{width:100%;border:1rpx solid #e5eae3;border-radius:12rpx;padding:16rpx;box-sizing:border-box}.upload-image image{width:100%;height:260rpx}.upload-image .actions{margin-bottom:0}
