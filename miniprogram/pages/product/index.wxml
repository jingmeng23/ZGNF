<view class="page">
  <view wx:if="{{error}}" class="error">{{error}}</view><view wx:if="{{notice}}" class="notice">{{notice}}</view>
  <view wx:if="{{loading}}" class="empty">正在读取商品信息…</view>
  <block wx:if="{{detail}}">
    <swiper wx:if="{{images.length}}" indicator-dots="{{images.length > 1}}" style="height:480rpx"><swiper-item wx:for="{{images}}" wx:key="*this"><image class="image" style="height:480rpx" src="{{item}}" mode="aspectFit" data-url="{{item}}" bindtap="preview"/></swiper-item></swiper>
    <view class="card"><view class="title">{{detail.product.name}}</view><view class="muted">{{detail.product.subtitle}}</view><view wx:if="{{detail.product.brandName}}" class="muted">品牌 · {{detail.product.brandName}}</view><view class="row"><view class="price">¥{{detail.product.price}}</view><view class="status">{{detail.product.statusMessage}}</view></view><view wx:if="{{detail.product.originalPrice}}" class="muted">原价 ¥{{detail.product.originalPrice}}</view><view class="muted">可用库存 {{detail.product.availableStock}} · 已售 {{detail.product.sales}}</view><view wx:for="{{detail.servicePromises}}" wx:key="*this" class="muted">✓ {{item}}</view></view>
    <view wx:if="{{attributes.length}}" class="card"><view class="section">商品参数</view><view wx:for="{{attributes}}" wx:key="name" class="row"><text class="muted">{{item.name}}</text><text>{{item.value}}</text></view></view>
    <view wx:if="{{skus.length}}" class="card"><view class="section">选择商品规格</view><view wx:for="{{skuDimensions}}" wx:key="name" class="spec-row"><text>{{item.name}}</text><picker range="{{item.options}}" range-key="value" value="{{item.selectedIndex}}" data-index="{{index}}" bindchange="chooseSpec"><view class="spec-picker">{{item.options[item.selectedIndex].value}} ›</view></picker></view><view wx:if="{{selectedSku}}" class="notice">{{selectedSku.name}} · ¥{{selectedSku.price}} · 库存 {{selectedSku.availableStock}}</view><view wx:else class="muted">请选择可售规格。当前商城接口暂不能将多规格选择写入购物车。</view></view>
    <view class="card"><view class="section">商品详情</view><text style="white-space:pre-wrap">{{detail.description || '暂无补充说明'}}</text><image wx:for="{{detailImages}}" wx:key="*this" src="{{item}}" style="width:100%;margin:16rpx 0" mode="widthFix" data-url="{{item}}" bindtap="preview"/></view>
    <view class="card"><view class="row"><text>购买数量</text><view class="actions"><button class="secondary small" data-delta="-1" bindtap="quantity" disabled="{{busy || addLocked || quantity <= 1}}">−</button><input type="number" value="{{quantity}}" bindblur="quantity" style="width:130rpx;margin:0;text-align:center" disabled="{{busy || addLocked || !detail.product.purchasable}}"/><button class="secondary small" data-delta="1" bindtap="quantity" disabled="{{busy || addLocked || quantity >= maxQuantity}}">＋</button></view></view></view>
    <view class="actions"><button class="secondary" bindtap="favorite" disabled="{{busy}}">{{favorite ? '取消收藏' : '收藏商品'}}</button><button class="secondary" bindtap="cart">购物车</button><button bindtap="add" loading="{{busy}}" disabled="{{busy || !detail.product.purchasable || skus.length > 1}}">{{skus.length > 1 ? '暂不可下单' : (addLocked ? '重试加购' : '加入购物车')}}</button></view>
  </block>
  <button wx:if="{{error}}" class="secondary" bindtap="load" disabled="{{loading || busy}}">刷新商品</button>
</view>
