<view class="page"><view class="title">安心服务</view><view class="notice">发现疑似燃气泄漏，请勿开关电器或使用明火。离开现场后联系当地燃气应急服务。此处为一般服务预约。</view><view wx:if="{{error}}" class="error">{{error}}</view><view class="card"><picker range="{{types}}" value="{{typeIndex}}" data-field="typeIndex" bindchange="input">服务：{{types[typeIndex]}}</picker><input value="{{title}}" data-field="title" bindinput="input" placeholder="服务标题" maxlength="200"/><textarea value="{{description}}" data-field="description" bindinput="input" placeholder="描述设备与需要协助的问题" maxlength="5000"/><picker range="{{addresses}}" range-key="detail" value="{{addressIndex}}" data-field="addressIndex" bindchange="input">{{addresses.length ? addresses[addressIndex].detail : '暂无地址，请先添加'}}</picker><button class="secondary" bindtap="addresses">管理服务地址</button><view class="row"><picker mode="date" value="{{date}}" data-field="date" bindchange="input">{{date || '选择日期'}}</picker><picker mode="time" value="{{time}}" data-field="time" bindchange="input">{{time || '选择时间'}}</picker></view><button bindtap="submit" loading="{{busy}}" disabled="{{busy}}">提交预约</button></view><view class="section">我的服务工单</view><view wx:for="{{rows}}" wx:key="id" class="card"><view>{{item.title}} · {{item.status}}</view><view class="muted">{{item.appointmentTime}}</view><button class="secondary" data-id="{{item.id}}" bindtap="detail">查看详情与进度</button><button wx:if="{{item.status === 'pending' || item.status === 'accepted'}}" class="secondary" data-id="{{item.id}}" bindtap="cancel">取消预约</button></view><view class="actions"><button class="secondary" bindtap="previous" disabled="{{page <= 1}}">上一页</button><button class="secondary" bindtap="next" disabled="{{page >= pages}}">下一页</button></view></view>
