<view class="page"><view class="eyebrow">WELCOME HOME</view><view class="title">{{authenticated ? '关联当前微信' : registering ? '创建商城账号' : '登录自贡能发'}}</view><view class="notice">与燃气商城网站共用账号。首次请使用原手机号和密码登录，再绑定当前微信用于支付。</view><view wx:if="{{error}}" class="error">{{error}}</view><view wx:if="{{!authenticated}}" class="card"><input data-field="phone" value="{{phone}}" bindinput="input" type="number" maxlength="11" placeholder="手机号"/><input data-field="password" value="{{password}}" bindinput="input" password maxlength="64" placeholder="{{registering ? '8至64位，含大小写字母和数字' : '密码'}}"/><input wx:if="{{registering}}" data-field="nickname" value="{{nickname}}" bindinput="input" maxlength="64" placeholder="昵称（选填）"/><button bindtap="submit" loading="{{busy}}" disabled="{{busy}}">{{registering ? '注册' : '手机号密码登录'}}</button><button class="secondary" bindtap="toggle">{{registering ? '已有账号，去登录' : '注册新账号'}}</button></view><button bindtap="wechat" loading="{{busy}}" disabled="{{busy}}">{{authenticated ? '绑定当前微信' : '已绑定账号：微信登录'}}</button><button wx:if="{{authenticated}}" class="secondary" bindtap="done">返回商城</button></view>
