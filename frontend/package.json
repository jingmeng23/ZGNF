{
  "name": "zgnf-shop-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "regions:generate": "node scripts/generate-region-data.mjs",
    "dev": "vite --host 0.0.0.0",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "test": "vitest run",
    "format": "prettier --write src/admin src/api/admin.ts src/api/http.ts src/api/http.test.ts src/styles src/router/index.ts src/App.vue",
    "test:browser": "node scripts/smoke.mjs",
    "test:browser:aftersales": "node scripts/aftersales-smoke.mjs",
    "test:browser:overview": "node scripts/overview-smoke.mjs",
    "app:sync": "node scripts/android.mjs",
    "app:apk": "node scripts/android.mjs --apk",
    "app:release": "node scripts/android.mjs --release",
    "app:android": "cap open android",
    "app:ios": "cap open ios"
  },
  "dependencies": {
    "@amap/amap-jsapi-loader": "^1.0.1",
    "@capacitor/android": "^7.6.10",
    "@capacitor/app": "^7.1.2",
    "@capacitor/core": "^7.0.0",
    "@capacitor/keyboard": "^7.0.6",
    "@capacitor/network": "^7.0.4",
    "@capacitor/splash-screen": "^7.0.5",
    "@capacitor/status-bar": "^7.0.6",
    "address-parse": "^1.2.19",
    "element-plus": "^2.14.7",
    "lucide-vue-next": "^0.468.0",
    "pinia": "^3.0.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "prettier": "^3.9.10",
    "province-city-china": "^9.0.0",
    "typescript": "~5.7.2",
    "vite": "^6.0.5",
    "vitest": "^4.1.12",
    "vue-tsc": "^2.2.0"
  }
}
