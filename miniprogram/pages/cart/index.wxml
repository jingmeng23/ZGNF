<view class="page"><view class="title">购物车</view><view wx:if="error" class="error" bindtap="load">{{error}} · 重试</view><button wx:if="!authenticated" bindtap="login">登录后查看购物车</button><block wx:if="cart"><button class="secondary" bindtap="all" disabled="{{busy}}">全选商品</button><view wx:for="cart.items" wx:key="id" class="card"><view class="row"><image wx:if="item.image" class="thumb" src="{{item.image}}" mode="aspectFit"/><view><view>{{item.productName}}</view><view class="price">¥{{item.unitPrice}}</view><view class="muted">剩余 {{item.availableStock}} 件</view></view></view><view class="actions"><button class="secondary small" data-action="select" data-id="{{item.id}}" data-selected="{{item.selected}}" bindtap="update" disabled="{{busy}}">{{item.selected ? '已选' : '选择'}}</button><button class="secondary small" data-action="minus" data-id="{{item.id}}" data-quantity="{{item.quantity}}" bindtap="update" disabled="{{busy || item.quantity <= 1}}">−</button><view>{{item.quantity}}</view><button class="secondary small" data-action="plus" data-id="{{item.id}}" data-quantity="{{item.quantity}}" bindtap="update" disabled="{{busy || item.quantity >= item.availableStock}}">＋</button><button class="secondary small" data-action="remove" data-id="{{item.id}}" bindtap="update" disabled="{{busy}}">删除</button></view></view><view wx:for="cart.invalidItems" wx:key="id" class="card"><view>{{item.productName}} · 已失效或库存不足</view><button class="secondary" data-action="remove" data-id="{{item.id}}" bindtap="update">移除</button></view><view wx:if="!cart.items.length" class="empty">购物车还是空的</view><view class="actions"><button class="secondary" bindtap="previous" disabled="{{page <= 1}}">上一页</button><button class="secondary" bindtap="next" disabled="{{page * 20 >= cart.total}}">下一页</button></view><view class="card row"><view>已选 {{cart.selectedQuantity}} 件<view class="price">¥{{cart.selectedAmount}}</view></view><button bindtap="checkout" disabled="{{busy || !cart.selectedQuantity}}">确认结算</button></view></block></view>
