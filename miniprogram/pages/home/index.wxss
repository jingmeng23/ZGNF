.home { padding: 16rpx 32rpx 32rpx; padding-bottom: calc(32rpx + env(safe-area-inset-bottom)); }
.home button { display: flex; align-items: center; justify-content: center; min-height: 44px; margin: 0; padding: 0; border: 0; font-size: 26rpx; line-height: 1.4; }
.home button::after { border: 0; }
.brand-row { display: flex; align-items: center; gap: 16rpx; min-height: 76rpx; margin-bottom: 20rpx; }
.brand-mark { display: flex; align-items: center; justify-content: center; width: 64rpx; height: 64rpx; border-radius: 18rpx; background: #163f35; color: #fff; font-size: 34rpx; font-weight: 700; }
.brand-copy { display: flex; flex-direction: column; line-height: 1.4; }
.brand-name { font-size: 34rpx; color: #163f35; font-weight: 600; }
.brand-caption { font-size: 22rpx; color: #6b7e71; }
.search-bar { display: flex; align-items: center; gap: 18rpx; padding-left: 26rpx; background: #fff; border: 1rpx solid #e0e7df; border-radius: 24rpx; overflow: hidden; }
.search-icon { position: relative; box-sizing: border-box; flex-shrink: 0; width: 26rpx; height: 26rpx; margin-right: 4rpx; border: 3rpx solid #6d8175; border-radius: 50%; }
.search-icon::after { content: ''; position: absolute; width: 12rpx; height: 3rpx; right: -9rpx; bottom: -4rpx; transform: rotate(45deg); background: #6d8175; border-radius: 3rpx; }
.search-bar .search-input { flex: 1; min-width: 0; height: 44px; width: auto; padding: 0; margin: 0; background: transparent; font-size: 24rpx; }
.home .search-submit { align-self: stretch; flex-shrink: 0; min-width: 100rpx; padding: 0 20rpx; border-radius: 0; background: #087f95; color: #fff; }
.home .theme-banner { position: relative; justify-content: flex-start; width: 100%; min-height: 264rpx; margin-top: 24rpx; padding: 24rpx 32rpx; border-radius: 24rpx; overflow: hidden; text-align: left; color: #fff; background: linear-gradient(115deg, #163f35, #285d4c); }
.banner-copy { position: relative; z-index: 1; display: flex; flex-direction: column; align-items: flex-start; }
.banner-kicker { color: #d4e5d7; font-size: 22rpx; letter-spacing: 2rpx; }
.banner-title { display: block; margin-top: 10rpx; white-space: pre-line; font-size: 40rpx; font-weight: 600; line-height: 1.3; }
.banner-title text { display: block; }
.banner-action { display: flex; align-items: center; gap: 22rpx; margin-top: 16rpx; padding: 8rpx 20rpx; border-radius: 24rpx; background: #e6f0e7; color: #163f35; font-size: 24rpx; }
.chevron { width: 12rpx; height: 12rpx; flex-shrink: 0; margin-right: 6rpx; border-top: 3rpx solid currentColor; border-right: 3rpx solid currentColor; transform: rotate(45deg); }
.banner-decoration { position: absolute; box-sizing: border-box; border: 1rpx solid rgba(230, 240, 231, .2); border-radius: 50%; }
.decoration-one { right: -120rpx; top: -100rpx; width: 420rpx; height: 420rpx; background: rgba(230, 240, 231, .04); }
.decoration-two { right: -50rpx; bottom: -170rpx; width: 340rpx; height: 340rpx; background: rgba(230, 240, 231, .06); }
.with-image .banner-copy { width: 60%; }
.banner-image { position: absolute; z-index: 0; right: 18rpx; top: 20rpx; width: 34%; height: calc(100% - 40rpx); border-radius: 16rpx; background: #fff; }
.section-heading { display: flex; justify-content: space-between; align-items: center; gap: 16rpx; margin: 20rpx 0 8rpx; }
.section-title { font-size: 36rpx; font-weight: 600; color: #263e30; }
.home .view-all { gap: 12rpx; padding-left: 20rpx; color: #61786a; background: transparent; font-size: 24rpx; }
.product-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 22rpx; }
.product-card { min-width: 0; overflow: hidden; border: 1rpx solid #e6ebe4; border-radius: 24rpx; background: #fff; }
.product-media { position: relative; width: 100%; height: 0; padding-top: 100%; background: #fff; overflow: hidden; }
.product-image { position: absolute; top: 0; left: 0; box-sizing: border-box; width: 100%; height: 100%; padding: 16rpx; }
.image-fallback { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; background: #edf2ec; color: #718275; font-size: 24rpx; }
.unavailable-badge { position: absolute; left: 16rpx; bottom: 12rpx; padding: 4rpx 14rpx; border-radius: 8rpx; color: #fff; background: rgba(61, 75, 65, .8); font-size: 22rpx; }
.product-info { padding: 12rpx 20rpx 16rpx; }
.product-name { height: 80rpx; overflow: hidden; color: #26382e; font-size: 28rpx; font-weight: 500; line-height: 40rpx; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
.product-subtitle { height: 34rpx; margin-top: 4rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: #77877b; font-size: 22rpx; line-height: 34rpx; }
.product-bottom { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; min-height: 44px; gap: 4rpx 8rpx; margin-top: 8rpx; }
.price-line { display: flex; align-items: baseline; gap: 2rpx; color: #b54728; white-space: nowrap; }
.currency { font-size: 24rpx; }
.product-price { font-size: 36rpx; font-weight: 600; }
.home .product-action { min-width: 44px; padding: 0 12rpx; margin-left: auto; flex-shrink: 0; border-radius: 14rpx; background: #087f95; color: #fff; font-size: 24rpx; }
.home .spec-action { color: #087f95; background: #e9f3f4; }
.unavailable-label, .price-pending { font-size: 22rpx; color: #7a8179; }
.home .service-entry { justify-content: flex-start; width: 100%; gap: 20rpx; margin-top: 28rpx; padding: 24rpx; border-radius: 24rpx; background: #e6f0e7; color: #163f35; text-align: left; }
.service-icon { display: flex; justify-content: center; align-items: center; width: 72rpx; height: 72rpx; flex-shrink: 0; border-radius: 20rpx; background: #f8fbf7; }
.service-icon image { width: 44rpx; height: 44rpx; }
.service-copy { flex: 1; min-width: 0; display: flex; flex-direction: column; }
.service-title { font-size: 28rpx; font-weight: 500; }
.service-note { margin-top: 6rpx; color: #627968; font-size: 22rpx; }
.home-footer { padding-top: 28rpx; color: #89968b; font-size: 22rpx; text-align: center; }
.home-error { display: flex; align-items: center; gap: 20rpx; margin-bottom: 20rpx; padding: 16rpx 24rpx; border-radius: 20rpx; background: #fff1e9; color: #954629; }
.error-copy { flex: 1; min-width: 0; display: flex; flex-direction: column; font-size: 28rpx; }
.error-detail { margin-top: 4rpx; font-size: 24rpx; overflow-wrap: break-word; }
.home .retry-button { min-width: 44px; padding: 0 16rpx; background: transparent; color: #954629; }
.action-error { margin-bottom: 20rpx; padding: 20rpx; border-radius: 16rpx; font-size: 26rpx; background: #fff1e9; color: #954629; }
.home-empty { display: flex; flex-direction: column; align-items: center; padding: 64rpx 20rpx; border-radius: 24rpx; background: #fff; text-align: center; }
.empty-title { font-size: 30rpx; color: #3e5847; }
.empty-note { margin-top: 12rpx; font-size: 24rpx; color: #78887c; }
.home .empty-button { margin-top: 28rpx; padding: 0 32rpx; border-radius: 16rpx; color: #fff; background: #087f95; }
.skeleton-card { padding: 16rpx; }
.skeleton { background: #edf2ec; border-radius: 12rpx; }
.skeleton-line { height: 28rpx; margin-top: 20rpx; }
.skeleton-line.short { width: 56%; margin-bottom: 16rpx; }
.home .button-pressed, .card-pressed { opacity: .78; }
.home .banner-pressed { opacity: .9; }
@media (max-width: 340px) {
  .product-info { padding-left: 14rpx; padding-right: 14rpx; }
  .product-price { font-size: 32rpx; }
  .search-bar { gap: 12rpx; padding-left: 20rpx; }
  .home .search-submit { min-width: 88rpx; padding: 0 12rpx; }
}
