<view class="page">
  <view class="title">购物车</view><view wx:if="{{error}}" class="error">{{error}}</view><view wx:if="{{notice}}" class="notice">{{notice}}</view>
  <button wx:if="{{!authenticated}}" bindtap="login">登录后查看购物车</button>
  <block wx:if="{{cart}}">
    <view class="row"><text class="muted">可购 {{cart.total}} 种 · 共 {{cart.totalQuantity}} 件</text><button class="secondary small" bindtap="all" disabled="{{busy || loading || !cart.total}}">{{allSelected ? '取消全选' : '全选可购商品'}}</button></view>
    <view wx:for="{{cart.items}}" wx:key="id" class="card">
      <view class="row" data-id="{{item.productId}}" bindtap="product"><image wx:if="{{item.image}}" class="thumb" src="{{item.image}}" mode="aspectFit"/><view><view>{{item.productName}}</view><view class="price">¥{{item.unitPrice}}</view><view class="muted">库存 {{item.availableStock}} · 小计 ¥{{item.subtotal}}</view></view></view>
      <view wx:if="{{item.priceChanged}}" class="notice">商品价格已变动，结算以当前价格为准</view>
      <view class="actions"><button class="secondary small" data-action="select" data-id="{{item.id}}" bindtap="update" disabled="{{busy || loading}}">{{item.selected ? '✓ 已选' : '选择'}}</button><button class="secondary small" data-action="minus" data-id="{{item.id}}" bindtap="update" disabled="{{busy || loading || item.quantity <= 1}}">−</button><input style="width:120rpx;margin:0;text-align:center" type="number" value="{{item.quantity}}" data-id="{{item.id}}" bindblur="quantity" disabled="{{busy || loading}}"/><button class="secondary small" data-action="plus" data-id="{{item.id}}" bindtap="update" disabled="{{busy || loading || item.quantity >= item.availableStock || item.quantity >= 999}}">＋</button><button class="secondary small" data-action="remove" data-id="{{item.id}}" bindtap="update" disabled="{{busy || loading}}">删除</button></view>
    </view>
    <view wx:if="{{!cart.items.length}}" class="empty">暂无可购买商品，去商城看看吧</view>
    <view class="actions"><button class="secondary" bindtap="previous" disabled="{{busy || loading || page <= 1}}">上一页</button><text>{{page}} / {{pages}}</text><button class="secondary" bindtap="next" disabled="{{busy || loading || page >= pages}}">下一页</button></view>
    <view wx:if="{{cart.invalidItems.length}}" class="section">暂不可购买 · {{cart.invalidItems.length}} 种</view>
    <view wx:for="{{cart.invalidItems}}" wx:key="id" class="card">
      <view>{{item.productName}} × {{item.quantity}}</view><view class="muted">{{item.degraded ? '商品信息暂不可用，请稍后刷新' : '已下架或库存不足'}} · 当前库存 {{item.availableStock}}</view>
      <view class="actions"><button wx:if="{{item.selected}}" class="secondary" data-action="select" data-id="{{item.id}}" bindtap="update" disabled="{{busy || loading}}">取消选中</button><button class="secondary" data-action="remove" data-id="{{item.id}}" bindtap="update" disabled="{{busy || loading}}">移除</button></view>
    </view>
    <view wx:if="{{selectedInvalid}}" class="error">有 {{selectedInvalid}} 种不可购买商品仍被选中，请取消选择后结算。</view>
    <view class="card row"><view>已选可购商品 {{cart.selectedQuantity}} 件<view class="price">¥{{cart.selectedAmount}}</view></view><button bindtap="checkout" disabled="{{busy || loading || !cart.selectedQuantity || selectedInvalid}}">确认结算</button></view>
    <view class="actions"><button class="secondary" data-action="selected" bindtap="batch" disabled="{{busy || loading || (!cart.selectedQuantity && !selectedInvalid)}}">删除已选</button><button class="secondary" data-action="invalid" bindtap="batch" disabled="{{busy || loading || !cart.invalidItems.length}}">清理不可购买</button><button class="secondary" data-action="clear" bindtap="batch" disabled="{{busy || loading || !cart.totalQuantity}}">清空购物车</button></view>
  </block>
  <view wx:if="{{loading}}" class="empty">正在同步购物车…</view>
  <button wx:if="{{authenticated}}" class="secondary" bindtap="load" disabled="{{busy || loading}}">刷新购物车</button>
</view>
