<view class="page"><view class="title">{{mine ? '我的优惠券' : '领券中心'}}</view><button class="secondary" bindtap="toggle">{{mine ? '去领券' : '查看已领取优惠券'}}</button><view wx:if="error" class="error">{{error}}</view><view wx:for="rows" wx:key="id" class="card"><view>{{item.name}}</view><view class="price">满 {{item.minimumAmount}} 减 {{item.amount}}</view><view class="muted">{{item.expireTime || item.endTime}} {{mine ? item.status : ''}}</view><button wx:if="!mine" bindtap="claim" data-id="{{item.id}}" disabled="{{busy}}">领取</button></view><view wx:if="!rows.length" class="empty">暂无优惠券</view><view class="actions"><button class="secondary" bindtap="previous" disabled="{{page <= 1}}">上一页</button><button class="secondary" bindtap="next" disabled="{{page >= pages}}">下一页</button></view></view>
