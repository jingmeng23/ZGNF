<view class="page"><view wx:if="error" class="error" bindtap="load">{{error}}</view><block wx:if="detail"><image wx:if="image" class="image" style="height:480rpx" src="{{image}}" mode="aspectFit"/><view class="card"><view class="title">{{detail.product.name}}</view><view class="muted">{{detail.product.subtitle}}</view><view class="price">¥{{detail.product.price}}</view><view class="status">{{detail.product.statusMessage}}</view><view class="divider"/><view>{{detail.description}}</view></view><view class="actions"><button class="secondary" bindtap="cart">购物车</button><button bindtap="add" loading="{{busy}}" disabled="{{busy || !detail.product.purchasable}}">加入购物车</button></view></block></view>
