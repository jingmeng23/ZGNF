page{background:#f5f7f4;color:#26382e;font-size:28rpx;line-height:1.65}.page{padding:32rpx 28rpx 60rpx}.eyebrow{font-size:21rpx;color:#647c69}.title{font-size:44rpx;font-weight:650;line-height:1.35;margin:12rpx 0 24rpx}.muted{color:#768279;font-size:25rpx}.hero{padding:48rpx 36rpx;background:#163f35;color:#fff;border-radius:20rpx;margin-bottom:30rpx}.hero .muted{color:#cadace}.hero .title{font-size:50rpx}.card{background:#fff;border:1rpx solid #e5eae3;border-radius:16rpx;padding:24rpx;margin-bottom:20rpx}.row{display:flex;align-items:center;justify-content:space-between;gap:20rpx}.grid{display:grid;grid-template-columns:1fr 1fr;gap:20rpx}.price{font-size:34rpx;font-weight:650;color:#b54728}.image{width:100%;height:240rpx;background:#edf1eb;border-radius:10rpx}.thumb{width:130rpx;height:130rpx;background:#edf1eb;flex-shrink:0}.section{font-size:32rpx;font-weight:600;margin:28rpx 0 18rpx}.error{padding:20rpx;background:#fff1e9;color:#a44121;border-radius:10rpx;margin-bottom:20rpx}.notice{background:#e6f0e7;padding:20rpx;border-radius:10rpx;margin-bottom:20rpx}input,textarea,picker{box-sizing:border-box;background:#f4f6f2;padding:20rpx;border-radius:10rpx;margin:16rpx 0;width:100%}textarea{height:180rpx}button{box-sizing:border-box;min-height:88rpx;font-size:28rpx;line-height:1.35;border-radius:10rpx;margin:18rpx 0;background:#163f35;color:white}button::after{border:0}button.secondary{background:#e6f0e7;color:#163f35}button.small{min-height:56rpx;font-size:23rpx;margin:8rpx 0;padding:4rpx 18rpx}button.quick-add{width:112rpx;height:56rpx;min-height:56rpx;line-height:56rpx;margin:0;padding:0 12rpx;font-size:22rpx}button[disabled]{opacity:.5}.actions{display:flex;gap:16rpx;flex-wrap:wrap}.actions button{flex:1}.status{display:inline-block;padding:4rpx 16rpx;border-radius:20rpx;background:#eaf0e7;color:#285340;font-size:23rpx}.divider{height:1rpx;background:#e7ece4;margin:22rpx 0}.empty{text-align:center;padding:70rpx 20rpx;color:#7c877e}.label{font-size:25rpx;margin-top:22rpx;color:#5f7264}
