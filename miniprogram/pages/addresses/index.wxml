<view class="page">
  <view class="title">{{choosing ? '选择收货地址' : '收货地址'}}</view><view wx:if="{{error}}" class="error">{{error}}</view>
  <view wx:for="{{rows}}" wx:key="id" class="card">
    <view data-id="{{item.id}}" bindtap="select"><view>{{item.receiver}} · {{item.phone}} <text wx:if="{{item.isDefault}}" class="status">默认</text></view><view class="muted">{{item.province}}{{item.city}}{{item.district}}{{item.detail}}</view><view wx:if="{{choosing}}" class="muted">点按选择此地址 ›</view></view>
    <view class="actions"><button wx:if="{{!item.isDefault}}" class="secondary small" data-id="{{item.id}}" bindtap="defaultAddress" disabled="{{busy || loading}}">设为默认</button><button class="secondary small" data-id="{{item.id}}" bindtap="edit" disabled="{{busy || loading}}">编辑</button><button class="secondary small" data-id="{{item.id}}" bindtap="remove" disabled="{{busy || loading}}">删除</button></view>
  </view>
  <view wx:if="{{!rows.length && !loading}}" class="empty">暂无收货地址，请先添加</view><button class="secondary" bindtap="add" disabled="{{busy || loading}}">新增地址</button>
  <view wx:if="{{editing}}" class="card"><view class="section">{{form.id ? '编辑地址' : '新增地址'}}</view><input value="{{form.receiver}}" data-field="receiver" bindinput="input" placeholder="收件人（2至20字）" maxlength="20" disabled="{{busy}}"/><input value="{{form.phone}}" data-field="phone" bindinput="input" maxlength="11" type="number" placeholder="手机号码" disabled="{{busy}}"/><picker mode="region" value="{{region}}" bindchange="region" disabled="{{busy}}">{{form.province ? form.province + ' / ' + form.city + ' / ' + form.district : '选择省 / 市 / 区'}}</picker><textarea value="{{form.detail}}" data-field="detail" bindinput="input" maxlength="255" placeholder="街道门牌详细地址，不少于5字" disabled="{{busy}}"/><button bindtap="save" loading="{{busy}}" disabled="{{busy}}">保存地址</button><button class="secondary" bindtap="closeEdit" disabled="{{busy}}">取消编辑</button></view>
  <button wx:if="{{error}}" class="secondary" bindtap="load" disabled="{{busy || loading}}">重新加载</button>
</view>
