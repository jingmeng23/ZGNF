<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.gas.ecommerce.modules.order.mapper.OrderMapper">
    <select id="selectExpiredOrderIds" resultType="long">
        SELECT id FROM `order` WHERE status = 'pending_payment' AND expire_time &lt;= NOW() AND is_deleted = 0
    </select>
</mapper>
