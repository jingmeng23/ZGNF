<view class="page"><view class="title">确认订单</view><view wx:if="error" class="error">{{error}}</view><view class="card" bindtap="address"><view class="section">收货地址 ›</view><block wx:if="address"><view>{{address.receiver}} · {{address.phone}}</view><view class="muted">{{address.province}}{{address.city}}{{address.district}}{{address.detail}}</view></block><view wx:else>请先添加收货地址</view></view><button class="secondary" bindtap="coupons" disabled="{{busy}}">选择优惠券</button><view wx:if="quote" class="card"><view wx:for="quote.items" wx:key="productId" class="row"><view>{{item.productName}} × {{item.quantity}}</view><view>¥{{item.unitPrice}}</view></view><view class="divider"/><view class="row"><text>商品金额</text><text>¥{{quote.totalAmount}}</text></view><view class="row"><text>优惠</text><text>−¥{{quote.discountAmount}}</text></view><view class="row"><text>运费</text><text>¥{{quote.freightAmount}}</text></view><view class="row"><text>应付金额</text><text class="price">¥{{quote.payAmount}}</text></view></view><button bindtap="submit" loading="{{busy}}" disabled="{{busy || !quote}}">提交订单，前往付款</button><view class="muted">价格、配送范围与库存由商城在提交时再次校验。</view></view>
