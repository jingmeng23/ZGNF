page { background: #f5f7f4; }
.cart-page { padding: 24rpx 32rpx 184px; }
.cart-page button { display: flex; align-items: center; justify-content: center; min-height: 44px; margin: 0; padding: 0 16rpx; border: 0; border-radius: 12rpx; background: transparent; color: #536b5e; font-size: 26rpx; line-height: 1.4; font-weight: 400; }
.cart-page button::after { border: 0; }
.cart-page button[disabled] { opacity: .45; }
.cart-header { display: flex; align-items: center; justify-content: space-between; gap: 24rpx; margin-bottom: 24rpx; }
.cart-heading { color: #163f35; font-size: 40rpx; font-weight: 600; line-height: 1.4; }
.cart-caption { font-size: 24rpx; color: #6f8074; margin-top: 6rpx; }
.cart-page .manage-button { color: #163f35; font-size: 28rpx; min-width: 52px; }
.cart-feedback { display: flex; align-items: center; gap: 12rpx; padding: 16rpx 20rpx; margin-bottom: 20rpx; border-radius: 16rpx; color: #9b4329; background: #fff0e8; font-size: 26rpx; overflow-wrap: break-word; }
.feedback-copy { flex: 1; min-width: 0; }
.cart-page .retry-button { flex-shrink: 0; color: #9b4329; }
.cart-note { padding: 20rpx; background: #e6f0e7; border-radius: 16rpx; color: #526c5a; font-size: 26rpx; margin-bottom: 20rpx; }
.cart-sync { padding: 0 8rpx 16rpx; font-size: 24rpx; color: #657d6c; }
.stale-note { color: #9b4329; }
.cart-product { margin-bottom: 20rpx; padding: 20rpx 20rpx 12rpx 0; border-radius: 24rpx; background: #fff; border: 1rpx solid #e7ece4; }
.product-row { display: flex; align-items: center; }
.cart-page .select-button { flex: 0 0 44px; width: 44px; padding: 0; align-self: stretch; border-radius: 12rpx 0 0 12rpx; }
.select-circle { display: flex; align-items: center; justify-content: center; box-sizing: border-box; width: 22px; height: 22px; border: 1.5px solid #a7b9ab; border-radius: 50%; background: #fff; flex-shrink: 0; }
.is-selected { background: #163f35; border-color: #163f35; }
.check-mark { width: 9px; height: 5px; margin-top: -3px; border-bottom: 2px solid #fff; border-left: 2px solid #fff; transform: rotate(-45deg); }
.is-partial { border-color: #163f35; background: #e6f0e7; }
.partial-mark { width: 9px; height: 2px; border-radius: 2px; background: #163f35; }
.cart-page .product-image-button { flex-shrink: 0; width: 176rpx; height: 176rpx; padding: 0; background: #f5f7f2; border-radius: 16rpx; overflow: hidden; }
.cart-image { box-sizing: border-box; width: 100%; height: 100%; padding: 10rpx; }
.image-placeholder { display: flex; width: 100%; height: 100%; align-items: center; justify-content: center; color: #839185; font-size: 22rpx; background: #edf2eb; }
.product-copy { min-width: 0; flex: 1; margin-left: 20rpx; }
.cart-page .product-name { display: -webkit-box; width: 100%; min-height: 44px; padding: 0; text-align: left; overflow: hidden; -webkit-box-orient: vertical; -webkit-line-clamp: 2; color: #263d30; font-size: 28rpx; font-weight: 500; line-height: 40rpx; border-radius: 0; }
.product-detail { margin-top: 6rpx; font-size: 22rpx; color: #718176; line-height: 1.5; }
.product-price { margin-top: 10rpx; font-size: 34rpx; font-weight: 600; line-height: 1.25; color: #b54728; overflow-wrap: anywhere; }
.currency { font-size: 24rpx; font-weight: 400; margin-right: 3rpx; }
.price-change { margin: 16rpx 0 4rpx 44px; padding: 10rpx 16rpx; background: #fff4ea; border-radius: 10rpx; color: #9a5230; font-size: 24rpx; }
.product-controls { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0 12rpx; margin: 12rpx 0 0 44px; }
.item-subtotal { flex: 1; color: #6f7d72; font-size: 24rpx; white-space: nowrap; }
.quantity-stepper { display: flex; align-items: center; flex-shrink: 0; margin-left: auto; }
.cart-page .quantity-button { width: 44px; min-width: 44px; height: 44px; padding: 0; color: #163f35; border-radius: 10px; }
.quantity-icon { position: relative; box-sizing: border-box; width: 28px; height: 28px; border: 1px solid #dce6df; border-radius: 8px; background: #f7f9f6; }
.quantity-icon::before, .quantity-plus .quantity-icon::after { content: ''; position: absolute; top: 50%; left: 50%; width: 11px; height: 1.5px; border-radius: 1px; background: currentColor; transform: translate(-50%, -50%); }
.quantity-plus .quantity-icon { border-color: #d9e7dd; background: #e6f0e7; }
.quantity-plus .quantity-icon::after { width: 1.5px; height: 11px; }
.cart-page .quantity-input { box-sizing: border-box; width: 32px; height: 44px; padding: 0; margin: 0; border-radius: 0; background: transparent; text-align: center; color: #263d30; font-size: 14px; font-weight: 500; line-height: normal; font-variant-numeric: tabular-nums; }
.cart-page .quantity-button[disabled] { opacity: 1; color: #163f35; }
.cart-page .quantity-limit .quantity-icon { color: #b9c4bd; border-color: #edf0eb; background: #fafbf9; }
.cart-page .quantity-pressed .quantity-icon { background: #d6e7db; border-color: #b6cfbf; }
/* Quantity requests lock actions without flashing every button or changing layout. */
.cart-page.quantity-updating button[disabled] { opacity: 1; }
.cart-page .remove-button { color: #96624b; font-size: 24rpx; padding: 0 12rpx; flex-shrink: 0; }
.manage-toolbar { display: flex; align-items: center; justify-content: space-between; padding: 0 4rpx 12rpx; font-size: 24rpx; color: #65786b; }
.cart-page .danger-text { color: #a5442b; font-size: 24rpx; }
.cart-pagination { display: flex; align-items: center; justify-content: center; gap: 28rpx; padding: 8rpx 0 24rpx; color: #718176; font-size: 24rpx; }
.cart-pagination button { min-width: 144rpx; background: #fff; }
.invalid-section { padding: 16rpx 20rpx 0; border-radius: 24rpx; background: #eef1eb; margin-top: 28rpx; }
.invalid-heading { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; }
.invalid-title { color: #516557; font-size: 30rpx; font-weight: 600; }
.invalid-count { margin-left: 12rpx; font-size: 24rpx; color: #7c887e; white-space: nowrap; }
.cart-page .clean-button { padding: 0 4rpx; font-size: 24rpx; color: #657b6b; }
.invalid-tip { font-size: 23rpx; color: #778378; margin: 4rpx 0 16rpx; }
.invalid-product { display: flex; flex-wrap: wrap; align-items: center; gap: 16rpx; padding: 20rpx 0; border-top: 1rpx solid #dce4da; }
.invalid-image-frame { position: relative; width: 128rpx; height: 128rpx; flex-shrink: 0; border-radius: 12rpx; overflow: hidden; background: #fff; }
.invalid-image-frame .cart-image { opacity: .6; }
.invalid-badge { position: absolute; bottom: 0; left: 0; right: 0; text-align: center; padding: 2rpx 0; font-size: 20rpx; background: rgba(71, 86, 75, .75); color: #fff; }
.invalid-copy { flex: 1; min-width: 120rpx; }
.invalid-name { font-size: 26rpx; color: #647268; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; line-height: 1.5; }
.invalid-reason { color: #92705c; font-size: 23rpx; line-height: 1.5; margin-top: 8rpx; }
.invalid-quantity { color: #7c887e; font-size: 22rpx; margin-top: 4rpx; }
.cart-page .cancel-invalid { margin-left: auto; color: #6b7f70; font-size: 24rpx; }
.selected-warning { margin-top: 20rpx; }
.cart-bottom-note { margin-top: 24rpx; font-size: 23rpx; color: #7b897e; text-align: center; }
.cart-page .continue-shopping { margin: 12rpx auto 0; min-width: 120px; color: #163f35; }
/* The native tabBar already occupies the bottom safe area outside the page viewport. */
.cart-footer { position: fixed; bottom: 0; left: 0; right: 0; z-index: 10; box-sizing: border-box; padding: 12px 16px 10px; background: #fff; border-top: 1rpx solid #e5eae2; box-shadow: 0 -4px 20px rgba(22, 63, 53, .045); }
.footer-main { display: grid; grid-template-columns: 56px minmax(0, 1fr) 112px; align-items: center; column-gap: 12px; max-width: 560px; margin: 0 auto; }
.cart-page .select-all { gap: 6px; padding: 0; justify-content: flex-start; width: 56px; min-height: 48px; color: #516b5b; font-size: 13px; white-space: nowrap; border-radius: 0; }
.footer-summary { min-width: 0; text-align: left; }
.summary-label { font-size: 11px; color: #65796b; line-height: 16px; white-space: nowrap; }
.summary-price { display: flex; align-items: baseline; color: #b54728; font-size: 23px; font-weight: 600; line-height: 30px; white-space: nowrap; font-variant-numeric: tabular-nums; }
.summary-price .currency { font-size: 14px; margin-right: 2px; }
.summary-pending { color: #7b897e; }
.summary-value { min-width: 0; }
.management-note { color: #92705c; font-size: 11px; line-height: 18px; }
.cart-page .checkout-button, .cart-page .delete-selected { box-sizing: border-box; width: 112px; min-width: 0; min-height: 48px; padding: 0 8px; color: #fff; background: #087f95; border-radius: 24px; font-size: 16px; font-weight: 600; white-space: nowrap; }
.cart-page .checkout-button[disabled] { opacity: 1; color: #74827e; background: #e5ebe8; }
.cart-page .checkout-button.checkout-quantity-pending[disabled] { color: #fff; background: #087f95; }
.cart-page .delete-selected { background: #fff; color: #a5442b; border: 1rpx solid #cfa18f; font-size: 14px; }
.footer-description { max-width: 560px; margin: 8px auto 0; color: #758477; font-size: 11px; line-height: 16px; text-align: center; }
.footer-guidance { display: flex; align-items: center; gap: 8px; max-width: 560px; min-height: 36px; box-sizing: border-box; margin: -4px auto 10px; padding: 4px 12px; border-radius: 10px; background: #f1f5ef; color: #617568; font-size: 12px; line-height: 18px; }
.guidance-warning { background: #fff3e9; color: #945133; }
.guidance-copy { flex: 1; min-width: 0; }
.cart-page .guidance-action { min-height: 44px; margin: -4px -8px -4px 0; padding: 0 8px; font-size: 12px; font-weight: 500; color: #163f35; white-space: nowrap; flex-shrink: 0; }
.footer-long-amount .footer-main { grid-template-columns: minmax(0, 1fr) 112px; row-gap: 8px; }
.footer-long-amount .footer-summary { grid-column: 1 / -1; grid-row: 1; display: flex; align-items: baseline; justify-content: space-between; gap: 12px; }
.footer-long-amount .select-all { grid-column: 1; grid-row: 2; }
.footer-long-amount .checkout-button { grid-column: 2; grid-row: 2; }
.footer-long-amount .summary-price { font-size: 21px; }
.cart-empty { display: flex; flex-direction: column; align-items: center; padding: 64rpx 28rpx 40rpx; border-radius: 24rpx; background: #fff; text-align: center; }
.empty-icon { display: flex; align-items: center; justify-content: center; width: 148rpx; height: 148rpx; border-radius: 50%; background: #eaf1e8; margin-bottom: 32rpx; }
.empty-icon image { width: 80rpx; height: 80rpx; }
.empty-heading { color: #163f35; font-size: 34rpx; font-weight: 600; }
.empty-description { color: #738276; font-size: 26rpx; margin-top: 16rpx; }
.cart-page .primary-button { background: #087f95; color: #fff; min-height: 48px; border-radius: 16rpx; }
.cart-page .empty-action { margin-top: 36rpx; min-width: 280rpx; }
.cart-page .text-button { margin-top: 8rpx; }
.cart-loading { text-align: center; color: #738276; font-size: 26rpx; margin-bottom: 24rpx; }
.cart-skeleton { display: flex; gap: 24rpx; padding: 28rpx; background: #fff; border-radius: 24rpx; margin-bottom: 20rpx; }
.skeleton-image { width: 176rpx; height: 176rpx; border-radius: 16rpx; background: #edf2eb; }
.skeleton-copy { flex: 1; padding-top: 12rpx; }
.skeleton-line { height: 26rpx; background: #edf2eb; margin-bottom: 24rpx; border-radius: 8rpx; }
.skeleton-line.short { width: 60%; }
.cart-page .cart-pressed { background: #edf3ed; }
.cart-page .primary-pressed { background: #066e81; }
@media (max-width: 340px) {
  .cart-page { padding-left: 24rpx; padding-right: 24rpx; }
  .cart-product { padding-right: 16rpx; }
  .product-copy { margin-left: 16rpx; }
  .cart-page .product-name { font-size: 14px; }
  .product-controls { justify-content: flex-end; }
  .item-subtotal { flex-basis: 100%; }
  .cart-footer { padding-left: 12px; padding-right: 12px; }
  .footer-main { grid-template-columns: 52px minmax(0, 1fr) 104px; column-gap: 8px; }
  .cart-page .select-all { width: 52px; }
  .summary-price { font-size: 20px; }
  .cart-page .checkout-button, .cart-page .delete-selected { width: 104px; }
  .footer-long-amount .footer-main { grid-template-columns: minmax(0, 1fr) 104px; }
}
