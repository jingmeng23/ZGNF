.catalog-page { min-height: 100vh; background: #f5f7f4; }
.catalog-page button, .filter-overlay button { display: flex; align-items: center; justify-content: center; min-height: 44px; margin: 0; padding: 0; border: 0; background: transparent; color: #52685a; font-size: 26rpx; line-height: 1.4; }
.catalog-page button::after, .filter-overlay button::after { border: 0; }
.catalog-header { position: sticky; top: 0; z-index: 5; padding-top: 20rpx; background: #f5f7f4; }
.catalog-search { display: flex; align-items: center; gap: 16rpx; margin: 0 32rpx 8rpx; padding-left: 24rpx; background: #fff; border: 1rpx solid #e0e7df; border-radius: 24rpx; overflow: hidden; }
.search-icon { position: relative; width: 26rpx; height: 26rpx; box-sizing: border-box; margin-right: 4rpx; border: 3rpx solid #6d8175; border-radius: 50%; flex-shrink: 0; }
.search-icon::after { content: ''; position: absolute; right: -9rpx; bottom: -4rpx; width: 12rpx; height: 3rpx; background: #6d8175; transform: rotate(45deg); }
.catalog-search .search-input { flex: 1; min-width: 0; width: auto; height: 44px; margin: 0; padding: 0; background: transparent; font-size: 26rpx; }
.catalog-search .search-submit { min-width: 100rpx; align-self: stretch; padding: 0 20rpx; border-radius: 0; background: #087f95; color: #fff; flex-shrink: 0; }
.catalog-search .clear-search { min-width: 44px; font-size: 22rpx; }
.category-scroll, .subcategory-scroll { width: 100%; white-space: nowrap; }
.category-tabs { display: inline-flex; padding: 0 22rpx; }
.category-tabs .category-tab { position: relative; padding: 0 24rpx; height: 100rpx; min-height: 44px; border-radius: 0; white-space: nowrap; color: #6a7c6e; font-size: 30rpx; }
.category-tabs .selected { color: #163f35; font-weight: 600; }
.category-tabs .selected::before { content: ''; position: absolute; bottom: 8rpx; left: calc(50% - 20rpx); width: 40rpx; height: 6rpx; border-radius: 4rpx; background: #163f35; }
.subcategory-tabs { display: inline-flex; align-items: center; gap: 12rpx; padding: 8rpx 32rpx 12rpx; }
.subcategory-tabs .subcategory-tab { padding: 0 24rpx; border-radius: 16rpx; background: #fff; color: #65766a; white-space: nowrap; font-size: 24rpx; }
.subcategory-tabs .selected { color: #163f35; background: #e6f0e7; font-weight: 600; }
.sort-bar { display: flex; margin: 0 32rpx; border-bottom: 1rpx solid #e2e9df; }
.sort-bar .sort-button { flex: 1; gap: 8rpx; min-width: 0; border-radius: 10rpx; color: #6b7a6e; font-size: 26rpx; }
.sort-bar .active { color: #087f95; font-weight: 600; }
.price-arrows { display: flex; flex-direction: column; gap: 5rpx; }
.arrow-up, .arrow-down { width: 0; height: 0; border-left: 6rpx solid transparent; border-right: 6rpx solid transparent; }
.arrow-up { border-bottom: 7rpx solid #a0aaa1; }
.arrow-down { border-top: 7rpx solid #a0aaa1; }
.arrow-up.arrow-active { border-bottom-color: #087f95; }
.arrow-down.arrow-active { border-top-color: #087f95; }
.filter-icon { width: 14rpx; height: 16rpx; border-top: 3rpx solid currentColor; border-bottom: 3rpx solid currentColor; transform: skew(-15deg); }
.filter-count { min-width: 26rpx; border-radius: 14rpx; background: #087f95; color: #fff; font-size: 20rpx; text-align: center; }
.catalog-content { padding: 0 32rpx 32rpx; padding-bottom: calc(32rpx + env(safe-area-inset-bottom)); }
.result-summary { display: flex; justify-content: space-between; gap: 20rpx; padding: 20rpx 0; color: #7a897d; font-size: 24rpx; }
.result-summary text:first-child { flex: 1; min-width: 0; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.result-summary text:last-child { flex-shrink: 0; }
.catalog-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 22rpx; }
.catalog-product { min-width: 0; border: 1rpx solid #e6ebe4; border-radius: 24rpx; background: #fff; overflow: hidden; }
.catalog-image-frame { position: relative; width: 100%; height: 0; padding-top: 100%; overflow: hidden; background: #fff; }
.catalog-image { position: absolute; top: 0; left: 0; box-sizing: border-box; width: 100%; height: 100%; padding: 16rpx; }
.catalog-image-fallback { position: absolute; top: 0; right: 0; bottom: 0; left: 0; display: flex; align-items: center; justify-content: center; color: #77877c; font-size: 24rpx; background: #edf2ec; }
.unavailable-badge { position: absolute; left: 16rpx; bottom: 12rpx; padding: 4rpx 14rpx; border-radius: 8rpx; color: #fff; background: rgba(61, 75, 65, .8); font-size: 22rpx; }
.product-info { padding: 12rpx 20rpx 16rpx; }
.catalog-product-name { height: 80rpx; overflow: hidden; color: #26382e; font-size: 28rpx; font-weight: 500; line-height: 40rpx; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
.catalog-product-subtitle { height: 34rpx; margin-top: 4rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: #77877b; font-size: 22rpx; line-height: 34rpx; }
.catalog-product-foot { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; min-height: 44px; gap: 4rpx 8rpx; margin-top: 8rpx; }
.catalog-price { display: flex; align-items: baseline; gap: 2rpx; color: #b54728; white-space: nowrap; font-size: 36rpx; font-weight: 600; }
.currency { font-size: 24rpx; font-weight: 400; }
.catalog-product-foot .product-action { min-width: 44px; padding: 0 12rpx; margin-left: auto; border-radius: 14rpx; background: #087f95; color: #fff; font-size: 24rpx; }
.catalog-product-foot .spec-action { color: #087f95; background: #e9f3f4; }
.unavailable-label { font-size: 22rpx; color: #7a8179; }
.list-footer { padding: 28rpx 0; text-align: center; color: #839084; font-size: 24rpx; }
.list-footer .load-more { width: 100%; color: #617a69; }
.options-notice, .request-error { display: flex; align-items: center; gap: 16rpx; margin-top: 16rpx; padding: 12rpx 20rpx; border-radius: 16rpx; background: #fff1e9; color: #954629; font-size: 24rpx; }
.request-error { margin: 0 0 20rpx; }
.options-notice > text { flex: 1; }
.error-copy { flex: 1; min-width: 0; display: flex; flex-direction: column; font-size: 28rpx; }
.error-detail { margin-top: 4rpx; font-size: 24rpx; overflow-wrap: break-word; }
.catalog-page .text-button { min-width: 44px; padding: 0 12rpx; color: #954629; flex-shrink: 0; }
.more-error { display: flex; flex-direction: column; align-items: center; }
.empty-state { display: flex; flex-direction: column; align-items: center; padding: 80rpx 20rpx; border-radius: 24rpx; background: #fff; text-align: center; }
.empty-symbol { width: 64rpx; height: 64rpx; border: 4rpx solid #b1c2b3; border-radius: 18rpx; background: #f0f5ef; margin-bottom: 28rpx; }
.empty-title { font-size: 30rpx; color: #3e5847; }
.empty-note { margin-top: 12rpx; font-size: 24rpx; color: #78887c; }
.empty-state .empty-button { margin-top: 28rpx; padding: 0 32rpx; border-radius: 16rpx; color: #fff; background: #087f95; }
.skeleton-card { padding: 16rpx; }
.skeleton { background: #edf2ec; border-radius: 12rpx; }
.skeleton-line { height: 28rpx; margin-top: 20rpx; }
.skeleton-line.short { width: 56%; margin-bottom: 16rpx; }
.pressed { opacity: .75; }
.filter-overlay { position: fixed; top: 0; right: 0; bottom: 0; left: 0; z-index: 20; }
.filter-mask { position: absolute; top: 0; right: 0; bottom: 0; left: 0; background: rgba(18, 39, 29, .42); }
.filter-sheet { position: absolute; bottom: 0; left: 0; right: 0; background: #fff; border-radius: 32rpx 32rpx 0 0; overflow: hidden; }
.sheet-heading { display: flex; justify-content: space-between; align-items: center; padding: 16rpx 32rpx; border-bottom: 1rpx solid #edf0eb; font-size: 36rpx; font-weight: 600; color: #163f35; }
.sheet-heading .cancel-button { min-width: 44px; font-size: 26rpx; font-weight: 400; }
.sheet-body { height: 48vh; }
.filter-field { padding: 28rpx 32rpx 0; }
.field-label { font-size: 28rpx; color: #334b3c; font-weight: 500; }
.filter-sheet .brand-picker { margin: 16rpx 0 0; padding: 0; background: #f5f7f4; border-radius: 16rpx; }
.brand-choice { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; min-height: 44px; padding: 0 24rpx; color: #597060; font-size: 28rpx; }
.brand-choice text { min-width: 0; flex: 1; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.chevron { width: 12rpx; height: 12rpx; flex-shrink: 0; border-top: 3rpx solid #84948b; border-right: 3rpx solid #84948b; transform: rotate(45deg); }
.price-inputs { display: flex; align-items: center; gap: 20rpx; margin-top: 16rpx; }
.price-inputs input { flex: 1; width: 0; min-width: 0; box-sizing: border-box; height: 44px; margin: 0; padding: 0 20rpx; border-radius: 16rpx; background: #f5f7f4; text-align: center; font-size: 28rpx; }
.range-separator { color: #7e8d81; font-size: 24rpx; }
.stock-field { display: flex; justify-content: space-between; align-items: center; gap: 20rpx; padding: 32rpx; }
.field-note { font-size: 24rpx; color: #7a897d; }
.filter-error { margin: 0 32rpx 20rpx; padding: 16rpx; border-radius: 12rpx; color: #954629; background: #fff1e9; font-size: 26rpx; }
.filter-note { padding: 0 32rpx 28rpx; font-size: 24rpx; color: #849085; }
.sheet-actions { display: flex; gap: 20rpx; padding: 20rpx 32rpx; padding-bottom: calc(20rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid #edf0eb; }
.sheet-actions .reset-button { flex: 1; border-radius: 18rpx; color: #163f35; background: #e6f0e7; }
.sheet-actions .apply-button { flex: 2; border-radius: 18rpx; color: #fff; background: #087f95; }
@media (max-width: 340px) {
  .product-info { padding-left: 14rpx; padding-right: 14rpx; }
  .catalog-price { font-size: 32rpx; }
  .catalog-search { gap: 10rpx; padding-left: 20rpx; }
  .catalog-search .search-submit { min-width: 88rpx; padding: 0 12rpx; }
}
