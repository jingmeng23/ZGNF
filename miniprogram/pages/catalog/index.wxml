<view class="page"><view class="eyebrow">CURATED FOR YOUR HOME</view><view class="title">好物商城</view><input placeholder="搜索商品" value="{{keyword}}" bindinput="input" bindconfirm="search"/><button bindtap="search" loading="{{loading}}">搜索</button><view wx:if="error" class="error">{{error}}</view><view class="grid"><view wx:for="products" wx:key="id" class="card" data-id="{{item.id}}" bindtap="product"><image wx:if="item.image" class="image" src="{{item.image}}" mode="aspectFit"/><view>{{item.name}}</view><view class="price">¥{{item.price}}</view><view class="muted">{{item.statusMessage}}</view></view></view><view wx:if="!products.length && !loading" class="empty">暂无匹配商品</view><view class="actions"><button class="secondary" disabled="{{page <= 1 || loading}}" bindtap="previous">上一页</button><button class="secondary" disabled="{{page >= pages || loading}}" bindtap="next">下一页</button></view><view class="muted">第 {{page}} 页</view></view>
