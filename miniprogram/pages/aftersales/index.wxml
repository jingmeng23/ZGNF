<view class="page">
  <view class="title">退款与售后</view><view wx:if="{{error}}" class="error">{{error}}</view><view wx:if="{{notice}}" class="notice">{{notice}}</view>
  <block wx:if="{{detail}}">
    <view class="card"><view class="status">{{detail.label}}</view><view class="section" selectable>{{detail.aftersaleNo}}</view><view>订单 {{detail.orderNo}}</view><view class="price">退款金额 ¥{{detail.amount}}</view><view class="label">申请原因</view><text style="white-space:pre-wrap">{{detail.reason}}</text><view class="muted">申请时间 {{detail.createTime}}</view><view wx:if="{{detail.reviewRemark}}"><view class="label">审核 / 撤销说明</view><text>{{detail.reviewRemark}}</text></view><view wx:if="{{detail.refundReference}}"><view class="label">退款渠道凭证</view><text selectable>{{detail.refundReference}}</text></view><view wx:if="{{detail.completionRemark}}">{{detail.completionRemark}}</view><view wx:if="{{detail.completedTime}}" class="muted">退款完成时间 {{detail.completedTime}}</view></view>
    <view class="card"><view class="section">处理进度</view><view wx:if="{{!operations.length}}" class="muted">暂无处理记录</view><view wx:for="{{operations}}" wx:key="id" style="padding:16rpx 0"><view>{{item.label}} · {{item.statusLabel}}</view><view>{{item.remark}}</view><view class="muted">{{item.operatorLabel}} · {{item.occurredAt}}</view></view></view>
    <button wx:if="{{detail.status === 'pending'}}" class="secondary" data-id="{{detail.id}}" bindtap="cancel" disabled="{{busy}}">撤销申请</button><button class="secondary" bindtap="order" disabled="{{busy}}">查看原订单</button><button class="secondary" bindtap="close" disabled="{{busy}}">返回售后列表</button>
  </block>
  <block wx:else>
    <view wx:if="{{orderId}}" class="card"><view class="section">申请整单退款</view><view wx:if="{{order}}">{{order.orderNo}}<view class="price">实付 ¥{{order.payAmount}}</view></view><textarea value="{{reason}}" data-field="reason" bindinput="input" maxlength="500" placeholder="请说明退款原因" disabled="{{busy || formLocked}}"/><button bindtap="submit" disabled="{{busy || loading}}" loading="{{busy}}">{{formLocked ? '重试原申请' : '提交售后申请'}}</button></view>
    <view wx:else class="notice">需要退款时，请从“我的订单 → 订单详情”发起申请。</view>
    <scroll-view scroll-x><view style="display:flex;gap:12rpx;white-space:nowrap"><button wx:for="{{statuses}}" wx:key="id" class="{{status === item.id ? 'small' : 'secondary small'}}" data-status="{{item.id}}" bindtap="filter" disabled="{{busy || loading}}">{{item.name}}</button></view></scroll-view>
    <view class="row"><input value="{{orderNo}}" data-field="orderNo" bindinput="input" bindconfirm="search" placeholder="按完整订单号查询" maxlength="40" disabled="{{busy || loading || formLocked}}"/><button class="small" bindtap="search" disabled="{{busy || loading}}">查询</button></view><view class="muted">共 {{total}} 笔售后</view>
    <view wx:for="{{rows}}" wx:key="id" class="card"><view class="row"><text selectable>{{item.aftersaleNo}}</text><text class="status">{{item.label}}</text></view><view class="muted">订单 {{item.orderNo}}</view><view class="price">¥{{item.amount}}</view><view>{{item.reason}}</view><view class="muted">{{item.reviewRemark}}</view><button class="secondary" data-id="{{item.id}}" bindtap="detail" disabled="{{busy || loading}}">查看详情与处理进度</button></view>
    <view wx:if="{{!rows.length && !loading}}" class="empty">暂无匹配的售后申请</view>
    <view class="actions"><button class="secondary" bindtap="previous" disabled="{{busy || loading || page <= 1}}">上一页</button><text>{{page}} / {{pages}}</text><button class="secondary" bindtap="next" disabled="{{busy || loading || page >= pages}}">下一页</button></view><button class="secondary" bindtap="load" disabled="{{busy || loading}}">刷新售后列表</button>
  </block>
</view>
